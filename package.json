  "homepage": "https://github.com/benrhodes/move-here-js",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-eslint": "^9.2.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^9.39.5",
    "eslint-config-techsmith": "^4.2.0",
    "globals": "^15.14.0",
    "http-server": "^14.1.1",
    "jasmine-core": "^5.1.0",
    "karma": "^6.4.4",
