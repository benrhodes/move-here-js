    "rollup": "^4.66.0"
  },
  "scripts": {
    "dev": "NODE_ENV=dev rollup --config ./rollup.config.js",
    "build": "NODE_ENV=production rollup --config ./rollup.config.js",
    "dev-es5": "NODE_ENV=dev-es5 rollup --config ./rollup.config.js",
    "build-es5": "NODE_ENV=production-es5 rollup --config ./rollup.config.js",
    "build-all": "npm run dev & npm run build & npm run dev-es5 & npm run build-es5",
